{
  "name": "straftat-presets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "npm run setup && next dev",
    "build": "next build",
    "preview": "npm run setup && opennextjs-cloudflare build && wrangler dev --local",
    "deploy": "node scripts/check-env.mjs .env.production && opennextjs-cloudflare build && wrangler deploy --secrets-file .env.production",
    "setup": "node scripts/setup.mjs && wrangler d1 migrations apply DB --local && tsx scripts/sync-game-catalog.ts local && tsx scripts/sync-tag-catalog.ts local",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "tsx scripts/check-game-catalog.ts && tsx scripts/check-tag-catalog.ts && npm run lint && npm run typecheck && npm test && npm run build",
    "cf:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "db:schema": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:backup": "node scripts/backup.mjs",
    "game:sync": "tsx scripts/check-game-catalog.ts && tsx scripts/sync-game-catalog.ts",
    "game:update": "node scripts/update-game-catalog.mjs --write",
    "weapons:normalize": "tsx scripts/normalize-weapons.ts",
    "tags:sync": "tsx scripts/check-tag-catalog.ts && tsx scripts/sync-tag-catalog.ts",
    "search:rebuild": "wrangler d1 migrations apply DB --local && tsx scripts/rebuild-preset-search.ts",
    "search:rebuild:remote": "tsx scripts/rebuild-preset-search.ts remote --confirm rebuild-published-search",
    "stats": "tsx scripts/preset-stats.ts"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "drizzle-orm": "0.45.2",
    "franc-min": "6.2.0",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
